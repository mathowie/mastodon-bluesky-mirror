# Copy this file to .env and fill every required value before starting.
# This template intentionally contains no account identifiers or credentials.

# Required: complete URL of your Mastodon instance, including https://
MASTODON_API_BASE_URL=
# Required: read-only access token for your own Mastodon account
MASTODON_ACCESS_TOKEN=

# Required: your existing Bluesky handle, without a leading @
BLUESKY_HANDLE=
# Required: a dedicated Bluesky app password
BLUESKY_APP_PASSWORD=

# Optional Threads destination; keep disabled until setup verifies your account.
THREADS_ENABLED=false
# Bootstrap credentials can instead be entered at the setup helper's hidden prompts.
# Uncomment these only when supplying a value; otherwise use hidden prompts.
# THREADS_ACCESS_TOKEN=
# THREADS_APP_SECRET=
# Optional assertion: the verified Threads account ID, never a username.
# THREADS_USER_ID=
# Long-lived token import only: uncomment and fill its absolute Unix expiry in seconds.
# Leave this line commented for short-lived token exchange or hidden prompts.
# THREADS_TOKEN_EXPIRES_AT=
# Private renewable credentials; retain this file across restarts and backups.
THREADS_TOKEN_FILE=data/threads-token.json

# Required: a long, unique password for the dashboard (username: admin)
DASHBOARD_PASSWORD=

# Optional preferences; these match the application's defaults.
SYNC_INTERVAL_SECONDS=60
MIRROR_SELF_REPLIES=true
MIRROR_REPLIES=false
MIRROR_CONTENT_WARNINGS=true
